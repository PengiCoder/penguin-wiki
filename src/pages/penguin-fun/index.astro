            padding: 10px 10px;
        }

	body {
        text-align: center;
        margin: 0;
        padding: 0;
        font-family: 'Kode Mono', 'Poppins', Arial;
        background-color: rgb(29, 29, 37);
        color: white;
    }

    body #copyleftSymbol {
        font-family: Arial;
    }

    a {
        color: #3f20cc;
    }

    h1{
        height: 20%;
        font-family: 'Kode Mono', 'Poppins', Arial;
        font-weight: 10000px;
        font-size: 75px;
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        background-image: linear-gradient(90deg, #2372ce, #0031b9, #4300fc, #8224ee, #4300fc, #0031b9, #2372ce);
        background-color: #1900ff;
        background-size: 300%;
        animation: textGradient 3s linear infinite; /* Add forwards to keep the final state */
}

    @keyframes textGradient {
        0% {
            background-position: 0 0%;
        }
        100% {
            background-position: 5000px 100%; /* Adjust ending keyframe position */
        }
    }
    
    .headerBar {
        position: -webkit-sticky;
        position: sticky;
        top: 0px;
        background-color: rgb(29, 29, 37);
    }

    .letsGoButton {
        text-decoration: none;
        padding: 0.5rem;
        border: 2px solid #6d00fc;
        color: white;
        background-color: #0031b9;
        border-radius: 6px;
        transition: background-color 1s ease;
    }

    .letsGoButton:hover {
        background-color: #6d00fc;
        border-color: #0031b9;
    }

    .goToFreedomButton {
        text-decoration: none;
        padding: 0.5rem;
        border: 2px solid #6d00fc;
        color: white;
        background-color: #0031b9;
        border-radius: 6px;
        transition: background-color 1s ease;
    }

    .goToFreedomButton:hover {
        background-color: #6d00fc;
        border-color: #0031b9;
    }

    .gamesPage {
        text-decoration: none;
        padding: 0.5rem;
        border: 2px solid #6d00fc;
        color: white;
        background-color: #0031b9;
        border-radius: 6px;
        transition: background-color 1s ease;
    }

    .gamesPage:hover {
        background-color: #6d00fc;
        border-color: #0031b9;
    }

    .mrPiggySignature {
        height: 400px;
        width: auto;
    }

    .stroke_1 {
        stroke-dasharray: 1445;
        stroke-dashoffset: 1445;
        animation: sign_1 3s ease forwards infinite;
        animation-fill-mode: forwards;
    }

    @keyframes sign_1 {
        to {
            stroke-dashoffset: 0;
        }
    }

    .stroke_2 {
        stroke-dasharray: 8;
        stroke-dashoffset: 8;
        animation: sign_2 3s ease forwards infinite;
        animation-fill-mode: infinite;
    }

    @keyframes sign_2 {
        to {
            stroke-dashoffset: 0;
        }
    }

    .stroke_3 {
        stroke-dasharray: 681;
        stroke-dashoffset: 681;
        animation: sign_3 3s ease forwards infinite;
        animation-fill-mode: forwards;
    }

    @keyframes sign_3 {
        0% {
            stroke-dashoffset: 681;
        }
        100% {
            stroke-dashoffset: 0;
        }
