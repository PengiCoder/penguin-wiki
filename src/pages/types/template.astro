---
import Layout from '../../layouts/Penguin-Layout.astro';
import Navbar from '../../components/Navbar.astro';

const currentDate = new Date();
let currentYear = currentDate.getFullYear();
---

<Layout title="Penguins">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Erect-Crested Penguins</title>
    </head>
    <body>
        <header class="header">
            <h1>Erect-Crested Penguin</h1>
        </header>
        <Navbar/>
        <main>
            <div class="container">
                <nav class="contents">
                    <h2>Contents:</h2>
                    <ul>
                        <li><a href="#overview">Overview</a></li>
                        <li><a href="#diet">Diet</a></li>
                        <li><a href="#behavior">Social Behavior</a></li>
                        <li><a href="#facts">Facts</a></li>
                    </ul>
                </nav>

                <section id="overview">
                    <h2>Overview</h2>
                    <ul>
                        <li>Scientific Name:</li>
                        <li>Size:</li>
                        <li>Habitat:</li>
                        <li>Conservation Status:</li>
                    </ul>
                </section>
                <section id="diet">
                    <h2>Diet</h2>
                    <p></p>
                </section>
                <section id="behavior">
                    <h2>Social Behavior</h2>
                    <p></p>
                </section>
                <section id="facts">
                    <h2>Interesting Facts</h2>
                    <ul>
                        <li></li>
                        <li></li>
                        <li></li>
                    </ul>
                </section>
            </div>
            <footer>
                <p><span class="copyleft">&copy;</span> PengiCoder & MrPiggy105, { currentYear }</p>
            </footer>
        </main>
    </body>
</Layout>

<style>
    .contents ul {
        list-style-type: none;
        padding: 0;
    }

    .contents li {
        margin-bottom: 10px;
    }

    section {
        overflow: hidden;
        margin-bottom: 20px;
        margin-left: 30%;
    }

    h1{
        text-align: center;
        height: 100%;
        font-family: 'Orkney', Arial;
    }
</style>